+def test_each_fold_preprocessing_ignores_its_validation_features(tmp_path: Path) -> None:
+    phase2, phase3 = _inputs(tmp_path, 180)
+    first = run_phase6_cv(phase2, phase3, tmp_path / "runs", "first", model_config=_models())
