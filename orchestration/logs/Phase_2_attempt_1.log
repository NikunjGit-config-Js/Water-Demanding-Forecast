+            "experiment_id": experiment_id,
+            "dataset": {"path": str(dataset_path), "sha256": source_hash_before},
+            "source_unchanged": True,
+            "lags": list(LAGS),
+            "rolling_windows": list(ROLLING_WINDOWS),
+            "ema_spans": list(EMA_SPANS),
