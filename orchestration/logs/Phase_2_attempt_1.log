+    assert original.loc[500, "consumption_lag_1"] == frame.loc[499, "Consumption"]
+    assert original.loc[500, "rolling_mean_7"] == frame.loc[493:499, "Consumption"].mean()
+    assert original.loc[500, "day_over_day_change"] == 1.0
