@@ -0,0 +1,179 @@
+"""Reproducible Phase 12 audit of the validated London forecasting pipeline.
+
+This audit does not replace the independent validator gate.  It verifies the
+approved checkpoint chain, source data, preserved evaluation artifacts, and
+reported metrics without fitting or selecting any model.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from orchestration.flow import _read_persisted_checkpoint  # noqa: E402
+
+
+DATASET = ROOT / "data/preprocessed/all/preprocessed_data.csv"
+EVALUATIONS = {
+    "phase5": (
+        ROOT / "artifacts/phase5/phase5_attempt_2_20260815T230000Z/predictions.csv",
+        ROOT / "artifacts/phase5/phase5_attempt_2_20260815T230000Z/metrics.csv",
+        False,
+    ),
+    "phase6": (
+        ROOT / "artifacts/phase6/phase6_attempt_1_20260815T233000Z/predictions.csv",
+        ROOT / "artifacts/phase6/phase6_attempt_1_20260815T233000Z/metrics_summary.csv",
+        True,
+    ),
+    "phase7": (
+        ROOT / "artifacts/phase7/phase7_attempt_1_20260815T223000Z/locked_test_predictions.csv",
+        ROOT / "artifacts/phase7/phase7_attempt_1_20260815T223000Z/locked_test_metrics.csv",
+        False,
+    ),
+    "phase8": (
+        ROOT / "artifacts/phase8/phase8_attempt_2_final_20260816T003000Z/predictions.csv",
+        ROOT / "artifacts/phase8/phase8_attempt_2_final_20260816T003000Z/metrics_summary.csv",
+        True,
+    ),
+    "phase9": (
+        ROOT / "artifacts/phase9/phase9_attempt_1_final_20260816T012000Z/predictions.csv",
+        ROOT / "artifacts/phase9/phase9_attempt_1_final_20260816T012000Z/metrics.csv",
+        False,
+    ),
+    "phase10": (
+        ROOT / "artifacts/phase10/phase10_attempt_1_final_20260816T021000Z/predictions.csv",
+        ROOT / "artifacts/phase10/phase10_attempt_1_final_20260816T021000Z/metrics.csv",
+        False,
+    ),
+}
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for block in iter(lambda: handle.read(1_048_576), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _metrics(actual: pd.Series, predicted: pd.Series) -> dict[str, float]:
+    residual = actual.to_numpy(float) - predicted.to_numpy(float)
+    mse = float(np.mean(residual**2))
+    denominator = float(np.sum((actual.to_numpy(float) - actual.mean()) ** 2))
+    return {
+        "mae": float(np.mean(np.abs(residual))),
+        "mse": mse,
+        "rmse": float(np.sqrt(mse)),
+        "r2": float(1.0 - np.sum(residual**2) / denominator),
+    }
+
+
+def _assert_close(actual: float, expected: float, label: str) -> None:
+    # Saved CSV predictions may have less precision than the in-memory values
+    # used to write metrics (notably float32 neural outputs).
+    if not np.isclose(actual, expected, rtol=1e-7, atol=1e-6):
+        raise ValueError(f"Metric mismatch for {label}: {actual} != {expected}")
+
+
+def _verify_evaluation(name: str, predictions_path: Path, metrics_path: Path, cv: bool) -> dict[str, Any]:
+    predictions = pd.read_csv(predictions_path)
+    reported = pd.read_csv(metrics_path).set_index("model")
+    models = [column for column in predictions if column not in {"Date", "actual", "fold"}]
+    if not models or predictions[["actual", *models]].isna().any().any():
+        raise ValueError(f"{name} predictions are empty or non-finite")
+
+    for model in models:
+        if cv and model == "selected_model":
+            # Phase 8's winner can differ by outer fold; candidate-family
+            # summaries intentionally have no synthetic selected_model row.
+            continue
+        if cv:
+            fold_values = []
+            for _, fold in predictions.groupby("fold", sort=True):
+                fold_values.append(_metrics(fold["actual"], fold[model]))
+            for metric in ("mae", "mse", "rmse", "r2"):
+                values = np.array([item[metric] for item in fold_values])
+                _assert_close(float(values.mean()), float(reported.loc[model, f"{metric}_mean"]), f"{name}/{model}/{metric}_mean")
+                _assert_close(float(values.std(ddof=1)), float(reported.loc[model, f"{metric}_std"]), f"{name}/{model}/{metric}_std")
+        else:
+            calculated = _metrics(predictions["actual"], predictions[model])
+            report_model = "ridge" if name == "phase7" and model == "selected_model" else model
+            for metric, value in calculated.items():
+                _assert_close(value, float(reported.loc[report_model, metric]), f"{name}/{model}/{metric}")
+    return {
+        "rows": len(predictions),
+        "models": models,
+        "predictions_sha256": _sha256(predictions_path),
+        "metrics_sha256": _sha256(metrics_path),
+    }
+
+
+def run_audit() -> dict[str, Any]:
+    checkpoints = []
+    for number in range(12):
+        checkpoint = _read_persisted_checkpoint(number)
+        checkpoints.append({
+            "phase": checkpoint.phase_name,
+            "validated_at_utc": checkpoint.validated_at_utc,
+            "test_returncode": checkpoint.test_evidence.returncode,
+        })
+
+    data = pd.read_csv(DATASET)
+    dates = pd.to_datetime(data["Date"], errors="raise")
+    if list(data.columns) != ["Date", "Consumption"]:
+        raise ValueError("Unexpected source dataset columns")
+    if len(data) != 3800 or data.isna().any().any() or data.duplicated().any():
+        raise ValueError("Source dataset shape, null, or duplicate invariant failed")
+    if not dates.is_monotonic_increasing or dates.duplicated().any():
+        raise ValueError("Source dates are not unique chronological observations")
+
+    evaluations = {
+        name: _verify_evaluation(name, predictions, metrics, cv)
+        for name, (predictions, metrics, cv) in EVALUATIONS.items()
+    }
+    return {
+        "phase": "Phase 12",
+        "scope": "pre-validator full validation audit",
+        "independent_validator_invoked": False,
+        "generated_at_utc": datetime.now(UTC).isoformat(),
+        "status": "AUDIT_CHECKS_PASSED",
+        "checkpoint_chain": checkpoints,
+        "dataset": {
+            "path": str(DATASET.relative_to(ROOT)),
+            "rows": len(data),
+            "start_date": dates.iloc[0].date().isoformat(),
+            "end_date": dates.iloc[-1].date().isoformat(),
+            "sha256": _sha256(DATASET),
+        },
+        "evaluations": evaluations,
+        "limitations": [
+            "This report is implementation evidence, not an independent validator verdict.",
+            "Phase 13 documentation and final artifacts are outside this audit's scope.",
+        ],
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    report = run_audit()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(f"{report['status']}: {args.output}")
+
+
+if __name__ == "__main__":
+    main()
