+            "test_returncode": checkpoint.test_evidence.returncode,
+        })
+
+    data = pd.read_csv(DATASET)
+    dates = pd.to_datetime(data["Date"], errors="raise")
+    if list(data.columns) != ["Date", "Consumption"]:
+        raise ValueError("Unexpected source dataset columns")
+    if len(data) != 3800 or data.isna().any().any() or data.duplicated().any():
+        raise ValueError("Source dataset shape, null, or duplicate invariant failed")
+    if not dates.is_monotonic_increasing or dates.duplicated().any():
+        raise ValueError("Source dates are not unique chronological observations")
+
+    evaluations = {
+        name: _verify_evaluation(name, predictions, metrics, cv)
+        for name, (predictions, metrics, cv) in EVALUATIONS.items()
+    }
+    return {
+        "phase": "Phase 12",
+        "scope": "pre-validator full validation audit",
+        "independent_validator_invoked": False,
+        "generated_at_utc": datetime.now(UTC).isoformat(),
+        "status": "AUDIT_CHECKS_PASSED",
+        "checkpoint_chain": checkpoints,
+        "dataset": {
+            "path": str(DATASET.relative_to(ROOT)),
+            "rows": len(data),
+            "start_date": dates.iloc[0].date().isoformat(),
+            "end_date": dates.iloc[-1].date().isoformat(),
