new file mode 100644
index 0000000000000000000000000000000000000000..f784147a2e3b3b2140d1b6d84c5d38814572ebbe
--- /dev/null
+++ b/tests/test_phase12_full_validation.py
@@ -0,0 +1,24 @@
+import json
+from pathlib import Path
+
+from experiments.phase12_full_validation import run_audit
+
+
+def test_full_validation_audit_recomputes_preserved_results() -> None:
+    report = run_audit()
+
+    assert report["status"] == "AUDIT_CHECKS_PASSED"
+    assert report["independent_validator_invoked"] is False
+    assert [item["phase"] for item in report["checkpoint_chain"]] == [
+        f"Phase {number}" for number in range(12)
+    ]
+    assert report["dataset"]["rows"] == 3800
+    assert set(report["evaluations"]) == {
+        "phase5", "phase6", "phase7", "phase8", "phase9", "phase10"
+    }
+
+
+def test_full_validation_report_is_json_serializable(tmp_path: Path) -> None:
+    destination = tmp_path / "report.json"
+    destination.write_text(json.dumps(run_audit()), encoding="utf-8")
+    assert json.loads(destination.read_text(encoding="utf-8"))["phase"] == "Phase 12"

