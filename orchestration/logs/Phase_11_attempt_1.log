+    hide_index=True,
+    use_container_width=True,
+)
+
+st.subheader("Downloads")
+download_columns = st.columns(2)
+download_columns[0].download_button(
+    "Download selected predictions (CSV)",
+    downloadable_predictions(window, model),
+    file_name=f"{spec.phase.lower().replace(' ', '_')}_{model}_{horizon}d_predictions.csv",
+    mime="text/csv",
+)
+download_columns[1].download_button(
+    "Download displayed results (Excel)",
+    downloadable_workbook(window, spec.model_columns),
+    file_name=f"{spec.phase.lower().replace(' ', '_')}_{horizon}d_results.xlsx",
+    mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+)
+
+with st.expander("About these results"):
+    st.write(
+        "The dashboard reads preserved experiment predictions only. The window control filters historical evaluation dates; "
+        "it does not retrain a model or claim a new future forecast. Phase 8 invalid/interim attempts and the failed Phase 9 "
+        "run are excluded from the artifact allowlist. Residual is actual minus predicted."
+    )
