+"""Artifact-backed data services for the Phase 11 Streamlit dashboard.
+
+This module deliberately does not load or execute fitted models.  The dashboard
+is a presentation layer over preserved, validated experiment outputs.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from io import BytesIO
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+METRIC_NAMES = ("MAE", "MSE", "RMSE", "R2")
