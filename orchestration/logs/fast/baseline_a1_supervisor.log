from __future__ import annotations

import argparse
import json
import subprocess
from datetime import datetime, timezone
from pathlib import Path

from orchestration.tools.fast_agent_cli import AgentExecutionError, run_codex_readonly, run_opencode_write

ROOT = Path(__file__).resolve().parents[1]
STATE_DIR = ROOT / "orchestration" / "state" / "fast"
STATE_PATH = STATE_DIR / "dual_agent_state.json"
STAGES = ["baseline", "better", "optimal", "final_notebook"]
REQUIRED = {
    "baseline": ["artifacts/fast/baseline/metrics.csv", "artifacts/fast/baseline/predictions.csv"],
    "better": ["artifacts/fast/better/metrics.csv", "artifacts/fast/better/cv_summary.csv"],
    "optimal": ["artifacts/fast/optimal/metrics.csv", "artifacts/fast/optimal/optuna_best_params.json", "artifacts/fast/optimal/keras_tuner_summary.json"],
    "final_notebook": ["notebooks/Water_Demand_Forecasting_Final.ipynb"],
}

def now() -> str:
    return datetime.now(timezone.utc).isoformat()

def load_state() -> dict:
    if STATE_PATH.exists():
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    return {"status": "ready", "completed": [], "active_stage": None, "attempts": {}, "updated_at": now()}

def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state["updated_at"] = now()
    STATE_PATH.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")

def git_status() -> str:
    p = subprocess.run(["git", "status", "--short"], cwd=ROOT, text=True, capture_output=True, check=False)
    return p.stdout[-12000:]

def quick_tests() -> str:
    tests = ROOT / "tests" / "fast_pipeline"
    if not tests.exists():
        return "NO_FAST_TEST_DIRECTORY_YET"
    p = subprocess.run([str(_python()), "-m", "pytest", "tests/fast_pipeline", "-q"], cwd=ROOT, text=True, capture_output=True, check=False, timeout=1800)
    return f"returncode={p.returncode}\nSTDOUT:\n{p.stdout[-12000:]}\nSTDERR:\n{p.stderr[-6000:]}"

def _python() -> Path:
    import sys
    return Path(sys.executable)

def required_gate(stage: str) -> tuple[bool, list[str]]:
    missing = [p for p in REQUIRED[stage] if not (ROOT / p).exists()]
    if stage == "final_notebook" and not missing:
        try:
            import nbformat
            nb = nbformat.read(ROOT / REQUIRED[stage][0], as_version=4)
            code = [c for c in nb.cells if c.cell_type == "code"]
            if not code or not any(c.get("execution_count") is not None for c in code):
                missing.append("notebook exists but has no executed code cells")
        except Exception as exc:
            missing.append(f"notebook validation error: {exc}")
    return (not missing, missing)

def supervisor_prompt(stage: str, attempt: int, previous_review: str) -> str:
    return f"""You are the Codex SUPERVISOR for the fast Siemens/KIT water-demand rebuild.
READ ONLY. Do not modify files.

Read these first:
- AGENTS.md
- AGENTS_FAST.md
- FAST_PROJECT_SPEC.md
- docs/FAST_ML_DL_RULEBOOK.md
- STATUS_FAST.md if present
- relevant current code/artifacts for stage {stage}

Stage: {stage}
Attempt: {attempt}
Previous review/corrections:
{previous_review or 'NONE'}

Your job is to generate ONE bounded implementation task for OpenCode that can be completed without asking the user anything. Preserve the baseline -> better -> optimal methodology and deadline. Use the real imported dataset only. Require actual execution and artifact evidence, not code-only claims.

Return exactly this structure:
OPENCODE_TASK
STAGE: {stage}
OBJECTIVE:
...
IMPLEMENTATION:
...
COMMANDS_TO_RUN:
...
ACCEPTANCE_CRITERIA:
...
DO_NOT:
...
"""

def implement_prompt(stage: str, instruction: str) -> str:
    return f"""You are OpenCode, the WRITE/EXECUTION agent for the water-demand project.
Read AGENTS.md, AGENTS_FAST.md, FAST_PROJECT_SPEC.md and docs/FAST_ML_DL_RULEBOOK.md before editing.
Do not ask the user questions. Do not push remote history.
Implement only the current stage and actually run the required training/tests. Reuse valid cached artifacts when possible. Keep the locked test untouched until the optimal stage.

CODEX SUPERVISOR INSTRUCTION:
{instruction}

When complete, update STATUS_FAST.md with exact commands, real metrics, GPU usage/fallbacks, files created, and unresolved limitations. End your response with IMPLEMENTATION_COMPLETE or IMPLEMENTATION_BLOCKED.
"""

def review_prompt(stage: str, instruction: str, implementation: str, tests: str, gate_missing: list[str]) -> str:
    return f"""You are the Codex INDEPENDENT REVIEWER. READ ONLY. Do not modify files.
Read AGENTS_FAST.md, FAST_PROJECT_SPEC.md, docs/FAST_ML_DL_RULEBOOK.md, the current diff, STATUS_FAST.md, code and artifacts for stage {stage}.

Supervisor instruction:
{instruction}

OpenCode claim:
{implementation[-12000:]}

Deterministic test output:
{tests[-12000:]}

Required artifact gate missing items:
{gate_missing or 'NONE'}

Validate methodology, leakage, chronological splitting, training-only preprocessing, correct OHE/ordinal/binary choices, Yeo-Johnson fit scope, real execution evidence, metrics, and GPU claims. For optimal stage, verify the locked test was untouched before final frozen evaluation. For final_notebook, verify the notebook is executed and numbers match preserved artifacts.

Return PASS on the first line if valid.
Otherwise return:
FAIL
REQUIRED_CORRECTIONS:
- exact correction 1
- ...
"""

def run(max_attempts: int) -> int:
    state = load_state()
    previous_review = ""
    for stage in STAGES:
        if stage in state.get("completed", []):
            continue
        state["status"] = "running"
        state["active_stage"] = stage
        save_state(state)
        for attempt in range(1, max_attempts + 1):
            state["attempts"][stage] = attempt
            save_state(state)
            print(f"\n=== {stage.upper()} | attempt {attempt}/{max_attempts} ===", flush=True)
            instruction = run_codex_readonly(supervisor_prompt(stage, attempt, previous_review), name=f"{stage}_a{attempt}_supervisor")
            (STATE_DIR / f"{stage}_a{attempt}_task.txt").write_text(instruction + "\n", encoding="utf-8")
            implementation = run_opencode_write(implement_prompt(stage, instruction), name=f"{stage}_a{attempt}_opencode")
            (STATE_DIR / f"{stage}_a{attempt}_implementation.txt").write_text(implementation + "\n", encoding="utf-8")
            tests = quick_tests()
            gate_ok, gate_missing = required_gate(stage)
            review = run_codex_readonly(review_prompt(stage, instruction, implementation, tests, gate_missing), name=f"{stage}_a{attempt}_review")
            (STATE_DIR / f"{stage}_a{attempt}_review.txt").write_text(review + "\n", encoding="utf-8")
            print(review, flush=True)
            if review.splitlines() and review.splitlines()[0].strip() == "PASS" and gate_ok:
                state.setdefault("completed", []).append(stage)
                state["active_stage"] = None
                save_state(state)
                previous_review = ""
                break
            previous_review = review
        else:
            state["status"] = "failed"
            state["active_stage"] = stage
            state["failure"] = previous_review
            save_state(state)
            print(f"FAILED: {stage} exhausted retry budget", flush=True)
            return 2
    state["status"] = "completed"
    state["active_stage"] = None
    save_state(state)
    print("\nFAST_DUAL_AGENT_WORKFLOW_COMPLETE", flush=True)
    print("Notebook: notebooks/Water_Demand_Forecasting_Final.ipynb", flush=True)
    return 0

def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--max-attempts", type=int, default=3)
    args = ap.parse_args()
    try:
        raise SystemExit(run(args.max_attempts))
    except AgentExecutionError as exc:
        print(f"AGENT_EXECUTION_ERROR: {exc}")
        raise SystemExit(3)

if __name__ == "__main__":
    main()
from __future__ import annotations

import shutil
import subprocess
import tempfile
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[2]
STATE_DIR = PROJECT_ROOT / "orchestration" / "state" / "fast"
LOG_DIR = PROJECT_ROOT / "orchestration" / "logs" / "fast"

class AgentExecutionError(RuntimeError):
    pass

def _run(command: list[str], timeout: int) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(command, cwd=PROJECT_ROOT, text=True, capture_output=True, timeout=timeout, check=False)
    except subprocess.TimeoutExpired as exc:
        raise AgentExecutionError(f"Agent timed out after {timeout}s") from exc

def _write_log(name: str, command: list[str], result: subprocess.CompletedProcess[str]) -> None:
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    (LOG_DIR / f"{name}.log").write_text(
        "COMMAND:\n" + " ".join(command[:-1]) + " [PROMPT]\n\nSTDOUT:\n" + result.stdout + "\n\nSTDERR:\n" + result.stderr,
        encoding="utf-8",
    )

def run_codex_readonly(prompt: str, *, name: str, timeout: int = 1800) -> str:
    exe = shutil.which("codex")
    if not exe:
        raise AgentExecutionError("Codex CLI not found on PATH")
    with tempfile.TemporaryDirectory(prefix="wf-codex-") as td:
        out = Path(td) / "last.txt"
        cmd = [exe, "exec", "-C", str(PROJECT_ROOT), "-s", "read-only", "--output-last-message", str(out), prompt]
        result = _run(cmd, timeout)
        _write_log(name, cmd, result)
        if result.returncode != 0:
            raise AgentExecutionError(f"Codex failed ({result.returncode}); see orchestration/logs/fast/{name}.log")
        if out.exists():
            return out.read_text(encoding="utf-8").strip()
        return result.stdout.strip()

def run_opencode_write(prompt: str, *, name: str, timeout: int = 7200) -> str:
    exe = shutil.which("opencode") or shutil.which("opencode2")
    if not exe:
        raise AgentExecutionError("OpenCode CLI not found on PATH")
    cmd = [exe, "run", "--dir", str(PROJECT_ROOT), "--auto", prompt]
    result = _run(cmd, timeout)
    _write_log(name, cmd, result)
    if result.returncode != 0:
        raise AgentExecutionError(f"OpenCode failed ({result.returncode}); see orchestration/logs/fast/{name}.log")
    return result.stdout.strip()

