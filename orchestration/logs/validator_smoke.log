from __future__ import annotations

import shutil
import subprocess
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parents[2]
STATE_DIR = PROJECT_ROOT / "orchestration" / "state"
LOG_DIR = PROJECT_ROOT / "orchestration" / "logs"

STATE_DIR.mkdir(parents=True, exist_ok=True)
LOG_DIR.mkdir(parents=True, exist_ok=True)


class CodexExecutionError(RuntimeError):
    """Raised when a Codex execution fails."""


def run_codex(
    prompt: str,
    *,
    sandbox: str = "workspace-write",
    output_name: str = "codex_last_message.txt",
    timeout: int = 3600,
) -> str:
    """
    Run Codex non-interactively inside the project.

    Default security:
    - workspace-write sandbox
    - automatic approval review
    - project root as working directory

    Returns Codex's final response.
    """

    codex_path = shutil.which("codex")

    if not codex_path:
        raise CodexExecutionError("Codex CLI was not found on PATH.")

    if sandbox not in {"read-only", "workspace-write"}:
        raise ValueError(
            "Only 'read-only' and 'workspace-write' are allowed by this wrapper."
        )

    output_file = STATE_DIR / output_name

    command = [
        codex_path,
        "exec",
        "-C",
        str(PROJECT_ROOT),
        "-s",
        sandbox,
        "--output-last-message",
        str(output_file),
    ]

    # Allow Codex to automatically review ordinary workspace operations.
    if sandbox == "workspace-write":
        command.append("--approve-for-me")

    command.append(prompt)

    result = subprocess.run(
        command,
        cwd=PROJECT_ROOT,
        text=True,
        capture_output=True,
        timeout=timeout,
        check=False,
    )

    log_file = LOG_DIR / f"{Path(output_name).stem}.log"

    log_file.write_text(
        "COMMAND:\n"
        + " ".join(command[:-1])
        + " [PROMPT]\n\n"
        + "STDOUT:\n"
        + result.stdout
        + "\n\nSTDERR:\n"
        + result.stderr,
        encoding="utf-8",
    )

    if result.returncode != 0:
        raise CodexExecutionError(
            f"Codex failed with return code {result.returncode}.\n"
            f"See log: {log_file}"
        )

    if not output_file.exists():
        raise CodexExecutionError(
            f"Codex completed but did not create {output_file}"
        )

    return output_file.read_text(encoding="utf-8").strip()


if __name__ == "__main__":
    response = run_codex(
        """
Read AGENTS.md and PROJECT_SPEC.md.

Do not modify project files.

Return exactly:

CODEX_WRAPPER_READY
PROJECT_RULES_LOADED: YES
WORKSPACE: water-forecast
""".strip(),
        sandbox="read-only",
        output_name="wrapper_smoke.txt",
    )

    print(response)
