+"""Validate the supplied daily water-demand data and preserve Phase 1 EDA artifacts."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import platform
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+import matplotlib
+import numpy as np
+import pandas as pd
+
+matplotlib.use("Agg")
