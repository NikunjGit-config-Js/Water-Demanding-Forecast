+def _inputs(root: Path, rows: int = 180) -> tuple[Path, Path]:
+    phase2 = root / "phase2"
+    phase2.mkdir()
+    dates = pd.date_range("2019-01-01", periods=rows, freq="D")
+    target = 100 + 8 * np.sin(np.arange(rows) * 2 * np.pi / 7) + np.arange(rows) * 0.05
