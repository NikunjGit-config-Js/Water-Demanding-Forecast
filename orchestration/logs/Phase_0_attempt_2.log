+    }
+
+    predictions.to_csv(output_dir / "predictions.csv", index=False)
+    _write_json(output_dir / "config.json", config)
+    _write_json(output_dir / "split_manifest.json", split_manifest)
+    _write_json(output_dir / "metrics.json", metrics)
