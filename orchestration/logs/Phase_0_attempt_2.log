+        "linear_regression.joblib",
+        "metrics.json",
+        "predictions.csv",
+        "split_manifest.json",
+        "standard_scaler.joblib",
+    }
+    assert {path.name for path in output.iterdir()} == expected
+    manifest = json.loads((output / "split_manifest.json").read_text())
