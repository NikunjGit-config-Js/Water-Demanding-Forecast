from datetime import UTC, datetime
from pathlib import Path
from typing import Any, ClassVar, Literal

os.environ.setdefault("CREWAI_DISABLE_TELEMETRY", "true")
os.environ.setdefault("OTEL_SDK_DISABLED", "true")

import yaml
