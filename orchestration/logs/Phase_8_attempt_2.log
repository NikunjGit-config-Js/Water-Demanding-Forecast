+
+def _load_candidate_frame(phase2_dir: Path, phase3_dir: Path) -> tuple[pd.DataFrame, dict[str, Any], dict[str, str]]:
+    """Load the full Phase 2 candidate schema; Phase 3 is provenance only."""
