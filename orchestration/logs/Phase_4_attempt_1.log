+    )
+    _write_json(
+        output_dir / "config.json",
+        {
+            "phase": "Phase 4",
+            "experiment_id": experiment_id,
+            "phase2_directory": str(Path(phase2_dir).resolve()),
+            "phase3_directory": str(Path(phase3_dir).resolve()),
