+    assert report["development_fit_rows"] < report["training_prefix_rows_loaded"]
+    assert report["fit_end_date_inclusive"] < report["assessment_start_date"]
+    assert set(metrics["model"]) == {"naive_lag_1", *report["model_names"]}
