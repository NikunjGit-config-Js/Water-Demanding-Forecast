+    patch_mae = float(metrics.loc[metrics["model"] == "patchtst", "mae"].iloc[0])
+    naive_mae = float(metrics.loc[metrics["model"] == "naive_lag1", "mae"].iloc[0])
+    report = {
+        "phase": "Phase 10", "candidate": "PatchTST", "candidate_count": 1,
